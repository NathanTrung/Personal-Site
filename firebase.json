{
  "hosting": {
    "headers": [
      {
        "source": "/favicon32x32.ico",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "public": "build",
    "ignore": [
      "firebase.json", 
      "**/.*",
      "**/node_modules/**"
    ],
    
    "redirects": [
      {
        "source": "nathantrung.web.app/**",
        "destination": "https://www.nathantrung.com",
        "type": 301
      },
      {
        "source": "nathantrung.com/**",
        "destination": "https://www.nathantrung.com",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
